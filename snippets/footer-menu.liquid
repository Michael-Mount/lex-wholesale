{% comment %}
  Crawlable footer navigation with a mobile accordion.

  Parameters:
  - menu
  - heading
  - section_id
  - block_id
{% endcomment %}

{% if menu != blank %}
  {% assign menu_heading = heading | default: menu.title %}
  {% assign heading_id = 'FooterMenuHeading-' | append: section_id | append: '-' | append: block_id %}

  <details class="site-footer__accordion" open>
    <summary class="site-footer__accordion-summary">
      <span id="{{ heading_id }}" class="site-footer__block-heading">
        {{ menu_heading | escape }}
      </span>

      <span class="site-footer__accordion-icon" aria-hidden="true"></span>
    </summary>

    <div class="site-footer__accordion-content">
      <nav aria-labelledby="{{ heading_id }}">
        <ul class="site-footer__menu-list" role="list">
          {% for link in menu.links %}
            <li>
              <a
                class="site-footer__link{% if link.active %} site-footer__link--active{% endif %}"
                href="{{ link.url }}"
                {% if link.current %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  </details>
{% endif %}
