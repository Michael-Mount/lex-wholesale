{% comment %}
  Displays one product inside the collection-wide Add All interface.

  Required:
  - product
  - section_id
  - position
  - is_approved_customer

  Optional:
  - show_vendor
  - show_individual_price
  - image_ratio
  - image_fit
  - variant_label
  - locked_message
{% endcomment %}

{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign selector_id = 'CollectionVariant-' | append: section_id | append: '-' | append: product.id
  assign image_ratio_value = image_ratio | default: 'portrait'
  assign image_fit_value = image_fit | default: 'cover'
  assign locked_text = locked_message | default: 'Sign in with an approved wholesale account to view pricing.'
  assign selected_variant_is_on_sale = false

  if selected_variant.compare_at_price > selected_variant.price
    assign selected_variant_is_on_sale = true
  endif
%}

<article
  class="collection-product{% unless product.available %} collection-product--unavailable{% endunless %}"
  data-collection-product
  data-product-position="{{ position }}">
  <div class="collection-product__media collection-product__media--{{ image_ratio_value }}" style="--collection-product-image-fit: {{ image_fit_value }};">
    <a
      class="collection-product__image-link"
      href="{{ product.url }}"
      tabindex="-1"
      aria-hidden="true">
      {% if product.featured_image != blank %}
        {{
          product.featured_image | image_url: width: 1000 | image_tag: class: 'collection-product__image', widths: '240, 360, 480, 600, 800, 1000', sizes: '(min-width: 990px) 33vw, 100vw', loading: 'lazy', alt: ''
        }}
      {% else %}
        <span class="collection-product__placeholder">
          No image
        </span>
      {% endif %}
    </a>

    <span class="collection-product__position" aria-hidden="true">
      {{ position }}
    </span>

    {% unless product.available %}
      <span class="collection-product__sold-out">
        Sold out
      </span>
    {% endunless %}
  </div>

  <div class="collection-product__content">
    {% if show_vendor and product.vendor != blank %}
      <p class="collection-product__vendor">
        {{ product.vendor | escape }}
      </p>
    {% endif %}

    <h2 class="collection-product__title">
      <a class="collection-product__title-link" href="{{ product.url }}">
        {{ product.title | escape }}
      </a>
    </h2>

    {% if is_approved_customer %}
      {% if product.available and selected_variant != blank %}
        {% if show_individual_price %}
          <div class="collection-product__price" data-collection-price-wrapper>
            <s
              class="collection-product__compare-price"
              data-collection-compare-price
              {% unless selected_variant_is_on_sale %}
              hidden{% endunless %}>
              {% if selected_variant.compare_at_price != blank %}
                {{ selected_variant.compare_at_price | money }}
              {% endif %}
            </s>

            <span class="collection-product__current-price" data-collection-current-price>
              {{ selected_variant.price | money }}
            </span>
          </div>
        {% endif %}

        {% if product.has_only_default_variant %}
          <input
            type="hidden"
            value="{{ selected_variant.id }}"
            data-collection-variant
            data-product-id="{{ product.id }}"
            data-product-title="{{ product.title | escape }}"
            data-price-text="{{ selected_variant.price | money | escape }}"
            data-compare-at-text="{{ selected_variant.compare_at_price | money | escape }}"
            data-price-cents="{{ selected_variant.price }}"
            data-compare-at-cents="{{ selected_variant.compare_at_price | default: 0 }}">

          <p class="collection-product__included">
            Included
          </p>
        {% else %}
          <div class="collection-product__selector">
            <label class="collection-product__selector-label" for="{{ selector_id }}">
              {{ variant_label | default: 'Choose an option' | escape }}
            </label>

            <select
              id="{{ selector_id }}"
              class="collection-product__select"
              data-collection-variant
              data-product-id="{{ product.id }}"
              data-product-title="{{ product.title | escape }}"
              required>
              {% for variant in product.variants %}
                {% if variant.available %}
                  <option
                    value="{{ variant.id }}"
                    data-price-text="{{ variant.price | money | escape }}"
                    data-compare-at-text="{{ variant.compare_at_price | money | escape }}"
                    data-price-cents="{{ variant.price }}"
                    data-compare-at-cents="{{ variant.compare_at_price | default: 0 }}"
                    {% if variant.id == selected_variant.id %}
                    selected{% endif %}>
                    {{ variant.title | escape }}
                  </option>
                {% endif %}
              {% endfor %}
            </select>
          </div>
        {% endif %}
      {% else %}
        <p class="collection-product__unavailable-message">
          This product currently has no available options.
        </p>
      {% endif %}
    {% else %}
      <p class="collection-product__locked-message">
        {{ locked_text | escape }}
      </p>
    {% endif %}
  </div>
</article>