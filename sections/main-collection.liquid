{{ 'section-main-collection.css' | asset_url | stylesheet_tag }}

<script src="{{ 'collection-add-all.js' | asset_url }}" defer></script>

{% liquid
  assign is_approved_customer = false
  assign collection_is_available = true
  assign maximum_products = 50
  assign sign_in_url = routes.storefront_login_url | default: routes.account_login_url
  assign locked_message = settings.locked_price_message | default: 'Sign in with an approved wholesale account to view pricing.'
  assign unapproved_message = settings.unapproved_price_message | default: 'Your account is not currently approved for wholesale purchasing.'
  assign application_label = settings.wholesale_application_label | default: 'Apply for wholesale access'

  if customer
    if settings.approved_customer_tag != blank
      if customer.tags contains settings.approved_customer_tag
        assign is_approved_customer = true
      endif
    endif
  endif

  if collection.products_count == 0 or collection.products_count > maximum_products
    assign collection_is_available = false
  endif
%}

<collection-add-all
  class="collection-add-all"
  data-collection-builder
  data-collection-handle="{{ collection.handle | escape }}"
  data-collection-title="{{ collection.title | escape }}"
  data-product-count="{{ collection.products_count }}"
  data-quantity-per-product="{{ section.settings.quantity_per_product }}"
  data-adding-message="{{ section.settings.adding_message | escape }}"
  data-added-message="{{ section.settings.added_message | escape }}"
  data-error-message="{{ section.settings.error_message | escape }}"
  style="
    --collection-background: {{ section.settings.background_color }};
    --collection-text: {{ section.settings.text_color }};
    --collection-border: {{ section.settings.border_color }};
    --collection-card-background: {{ section.settings.card_background_color }};
    --collection-button-background: {{ section.settings.button_background_color }};
    --collection-button-text: {{ section.settings.button_text_color }};
    --collection-columns-desktop: {{ section.settings.desktop_columns }};
    --collection-columns-mobile: {{ section.settings.mobile_columns }};
    --collection-grid-gap: {{ section.settings.grid_gap }}px;
    --collection-padding-top: {{ section.settings.padding_top }}px;
    --collection-padding-bottom: {{ section.settings.padding_bottom }}px;
  ">
  <section class="main-collection">
    <div class="page-width">
      <header class="main-collection__header">
        {% if section.settings.eyebrow != blank %}
          <p class="main-collection__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        <h1 class="main-collection__title">
          {{ collection.title | escape }}
        </h1>

        {% if section.settings.show_description and collection.description != blank %}
          <div class="main-collection__description rte">
            {{ collection.description }}
          </div>
        {% endif %}

        {% if section.settings.show_product_count %}
          <p class="main-collection__count">
            {{ collection.products_count }}
            {% if collection.products_count == 1 %}product{% else %}products{% endif %}
          </p>
        {% endif %}
      </header>

      {% if collection.products_count > maximum_products %}
        <div class="main-collection__notice main-collection__notice--error" role="alert">
          <h2 class="main-collection__notice-heading">
            This collection is too large for one-click purchasing
          </h2>

          <p>
            This implementation supports a maximum of {{ maximum_products }} products in one collection. 
            Reduce the collection size before enabling the Add Complete Collection button.
          </p>
        </div>
      {% endif %}

      {% paginate collection.products by 50 %}
        {% if collection.products.size > 0 %}
          <div class="main-collection__grid">
            {% for product in collection.products %}
              {% unless product.available %}
                {% assign collection_is_available = false %}
              {% endunless %}

              {% render 'bundle-product-selector'
                , product: product
                , section_id: section.id
                , position: forloop.index
                , is_approved_customer: is_approved_customer
                , show_vendor: section.settings.show_vendor
                , show_individual_price: section.settings.show_individual_price
                , image_ratio: section.settings.image_ratio
                , image_fit: section.settings.image_fit
                , variant_label: section.settings.variant_label
                , locked_message: locked_message
              %}
            {% endfor %}
          </div>
        {% else %}
          <div class="main-collection__empty">
            <h2>No products have been added to this collection.</h2>
          </div>
        {% endif %}

        {% if paginate.pages > 1 %}
          {% assign collection_is_available = false %}
        {% endif %}
      {% endpaginate %}

      {% if is_approved_customer %}
        <div class="main-collection__purchase">
          {% if section.settings.instructions != blank %}
            <div class="main-collection__instructions rte">
              {{ section.settings.instructions }}
            </div>
          {% endif %}

          <p
            class="main-collection__status"
            data-collection-status
            role="status"
            aria-live="polite"></p>

          <button
            class="main-collection__submit"
            type="button"
            data-collection-submit
            {% unless collection_is_available %}
            disabled{% endunless %}>
            <span data-collection-submit-text>
              {% if collection_is_available %}
                {{ section.settings.button_label | escape }}
              {% else %}
                {{ section.settings.unavailable_button_label | escape }}
              {% endif %}
            </span>
          </button>

          {% if section.settings.disclaimer != blank %}
            <p class="main-collection__disclaimer">
              {{ section.settings.disclaimer | escape }}
            </p>
          {% endif %}
        </div>
      {% else %}
        <div class="main-collection__gate">
          <h2 class="main-collection__gate-heading">
            Wholesale access required
          </h2>

          <p class="main-collection__gate-message">
            {% if customer %}
              {{ unapproved_message | escape }}
            {% else %}
              {{ locked_message | escape }}
            {% endif %}
          </p>

          <div class="main-collection__gate-actions">
            {% unless customer %}
              <a class="main-collection__secondary-button" href="{{ sign_in_url }}">
                Sign in
              </a>
            {% endunless %}

            {% if settings.wholesale_application_url != blank %}
              <a class="main-collection__secondary-button" href="{{ settings.wholesale_application_url }}">
                {{ application_label | escape }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </section>
</collection-add-all>

{% schema %}
  {
    "name": "Main collection",
    "tag": "section",
    "class": "section-main-collection",
    "settings": [
      {
        "type": "header",
        "content": "Collection header"
      },
      {
        "type": "text",
        "id": "eyebrow",
        "label": "Eyebrow",
        "default": "Complete collection"
      },
      {
        "type": "checkbox",
        "id": "show_description",
        "label": "Show collection description",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_product_count",
        "label": "Show product count",
        "default": true
      }, {
        "type": "header",
        "content": "Product cards"
      }, {
        "type": "checkbox",
        "id": "show_vendor",
        "label": "Show product vendor",
        "default": false
      }, {
        "type": "checkbox",
        "id": "show_individual_price",
        "label": "Show individual prices",
        "default": true,
        "info": "Prices are rendered only for approved wholesale customers."
      }, {
        "type": "text",
        "id": "variant_label",
        "label": "Variant selector label",
        "default": "Choose size and color"
      }, {
        "type": "select",
        "id": "image_ratio",
        "label": "Image ratio",
        "options": [
          {
            "value": "square",
            "label": "Square"
          }, {
            "value": "portrait",
            "label": "Portrait"
          }, {
            "value": "landscape",
            "label": "Landscape"
          }
        ],
        "default": "portrait"
      }, {
        "type": "select",
        "id": "image_fit",
        "label": "Image fit",
        "options": [
          {
            "value": "cover",
            "label": "Crop to fill"
          }, {
            "value": "contain",
            "label": "Fit entire image"
          }
        ],
        "default": "cover"
      }, {
        "type": "select",
        "id": "desktop_columns",
        "label": "Desktop columns",
        "options": [
          {
            "value": "2",
            "label": "2 columns"
          }, {
            "value": "3",
            "label": "3 columns"
          }, {
            "value": "4",
            "label": "4 columns"
          }
        ],
        "default": "3"
      }, {
        "type": "select",
        "id": "mobile_columns",
        "label": "Mobile columns",
        "options": [
          {
            "value": "1",
            "label": "1 column"
          }, {
            "value": "2",
            "label": "2 columns"
          }
        ],
        "default": "1"
      }, {
        "type": "range",
        "id": "grid_gap",
        "min": 8,
        "max": 40,
        "step": 4,
        "unit": "px",
        "label": "Grid spacing",
        "default": 24
      }, {
        "type": "header",
        "content": "Add complete collection"
      }, {
        "type": "richtext",
        "id": "instructions",
        "label": "Instructions",
        "default": "<p>Select an available option for each product, then add the entire collection with one button.</p>"
      }, {
        "type": "range",
        "id": "quantity_per_product",
        "min": 1,
        "max": 12,
        "step": 1,
        "label": "Quantity of each product",
        "default": 1
      }, {
        "type": "text",
        "id": "button_label",
        "label": "Button label",
        "default": "Add complete collection"
      }, {
        "type": "text",
        "id": "unavailable_button_label",
        "label": "Unavailable button label",
        "default": "Collection currently unavailable"
      }, {
        "type": "textarea",
        "id": "disclaimer",
        "label": "Disclaimer",
        "default": "Every selected product will be added to the cart in one request."
      }, {
        "type": "text",
        "id": "adding_message",
        "label": "Adding message",
        "default": "Adding complete collection…"
      }, {
        "type": "text",
        "id": "added_message",
        "label": "Success message",
        "default": "The complete collection was added to your cart."
      }, {
        "type": "text",
        "id": "error_message",
        "label": "Fallback error message",
        "default": "The complete collection could not be added. Please try again."
      }, {
        "type": "header",
        "content": "Colors"
      }, {
        "type": "color",
        "id": "background_color",
        "label": "Background",
        "default": "#ffffff"
      }, {
        "type": "color",
        "id": "text_color",
        "label": "Text",
        "default": "#231f1c"
      }, {
        "type": "color",
        "id": "border_color",
        "label": "Borders",
        "default": "#ded8d3"
      }, {
        "type": "color",
        "id": "card_background_color",
        "label": "Card background",
        "default": "#ffffff"
      }, {
        "type": "color",
        "id": "button_background_color",
        "label": "Primary button background",
        "default": "#231f1c"
      }, {
        "type": "color",
        "id": "button_text_color",
        "label": "Primary button text",
        "default": "#ffffff"
      }, {
        "type": "header",
        "content": "Spacing"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 120,
        "step": 8,
        "unit": "px",
        "label": "Top padding",
        "default": 64
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 120,
        "step": 8,
        "unit": "px",
        "label": "Bottom padding",
        "default": 80
      }
    ]
  }
{% endschema %}