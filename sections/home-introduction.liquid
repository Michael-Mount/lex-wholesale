{{ 'section-home-introduction.css' | asset_url | stylesheet_tag }}

{% liquid
  assign has_video = false
  assign has_image = false
  assign media_type = 'advertisement'

  if section.settings.background_video != blank
    assign has_video = true
    assign media_type = 'video'
  elsif section.settings.background_image != blank
    assign has_image = true
    assign media_type = 'image'
  endif
%}

<section
  id="HomeIntroduction-{{ section.id }}"
  class="
    home-introduction
    home-introduction--{{ media_type }}
    home-introduction--content-{{ section.settings.content_position }}
    home-introduction--card-{{ section.settings.content_card_style }}
  "
  style="
    --home-intro-height-desktop: {{ section.settings.height_desktop }}px;
    --home-intro-height-mobile: {{ section.settings.height_mobile }}px;
    --home-intro-image-position: {{ section.settings.image_focal_position }};
    --home-intro-overlay-color: {{ section.settings.overlay_color }};
    --home-intro-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --home-intro-text: {{ section.settings.text_color }};
    --home-intro-muted-text: {{ section.settings.muted_text_color }};
    --home-intro-button: {{ section.settings.button_background_color }};
    --home-intro-button-text: {{ section.settings.button_text_color }};
    --home-intro-card-background: {{ section.settings.card_background_color }};
    --home-intro-card-opacity: {{ section.settings.card_opacity }}%;
    --home-intro-fallback-background: {{ section.settings.fallback_background_color }};
    --home-intro-fallback-accent: {{ section.settings.fallback_accent_color }};
    --home-intro-fallback-accent-text: {{ section.settings.fallback_accent_text_color }};
    --home-intro-content-width: {{ section.settings.content_width }}rem;
    --home-intro-padding-top: {{ section.settings.padding_top }}px;
    --home-intro-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="home-introduction__media" aria-hidden="true">
    {% if has_video %}
      {{ section.settings.background_video | video_tag: class: 'home-introduction__video', autoplay: section.settings.autoplay_video, loop: section.settings.loop_video, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
    {% elsif has_image %}
      <picture>
        {% if section.settings.mobile_background_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.mobile_background_image | image_url: width: 900 }}"
          >
        {% endif %}

        {% assign background_alt = section.settings.background_image.alt | default: section.settings.heading %}

        {{ section.settings.background_image | image_url: width: 2400 | image_tag: class: 'home-introduction__image', widths: '750, 1000, 1250, 1500, 1800, 2100, 2400', sizes: '100vw', loading: 'eager', preload: true, alt: background_alt }}
      </picture>
    {% else %}
      <div class="home-introduction__ad-art">
        <span class="home-introduction__ad-orbit home-introduction__ad-orbit--one"></span>
        <span class="home-introduction__ad-orbit home-introduction__ad-orbit--two"></span>
        <span class="home-introduction__ad-line home-introduction__ad-line--one"></span>
        <span class="home-introduction__ad-line home-introduction__ad-line--two"></span>

        <div class="home-introduction__ad-copy">
          {% if section.settings.fallback_kicker != blank %}
            <span class="home-introduction__ad-kicker">
              {{ section.settings.fallback_kicker | escape }}
            </span>
          {% endif %}

          {% if section.settings.fallback_headline != blank %}
            <span class="home-introduction__ad-headline">
              {{ section.settings.fallback_headline | escape }}
            </span>
          {% endif %}

          {% if section.settings.fallback_supporting_text != blank %}
            <span class="home-introduction__ad-supporting">
              {{ section.settings.fallback_supporting_text | escape }}
            </span>
          {% endif %}

          {% if section.settings.fallback_badge != blank %}
            <span class="home-introduction__ad-badge">
              {{ section.settings.fallback_badge | escape }}
            </span>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>

  {% if has_video or has_image %}
    <span class="home-introduction__overlay" aria-hidden="true"></span>
  {% endif %}

  <div class="page-width home-introduction__inner">
    <div class="home-introduction__content home-introduction__content--{{ section.settings.text_alignment }}">
      {% if section.settings.eyebrow != blank %}
        <p class="home-introduction__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="home-introduction__heading">
          {{ section.settings.heading | escape }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="home-introduction__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.promotion_text != blank %}
        <p class="home-introduction__promotion">
          {{ section.settings.promotion_text | escape }}
        </p>
      {% endif %}

      {% if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank %}
        <div class="home-introduction__actions">
          {% if section.settings.primary_button_label != blank %}
            <a
              class="home-introduction__button home-introduction__button--primary"
              href="{{ section.settings.primary_button_link | default: routes.collections_url }}"
            >
              {{ section.settings.primary_button_label | escape }}
            </a>
          {% endif %}

          {% if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank %}
            <a
              class="home-introduction__button home-introduction__button--secondary"
              href="{{ section.settings.secondary_button_link }}"
            >
              {{ section.settings.secondary_button_label | escape }}
            </a>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.supporting_note != blank %}
        <p class="home-introduction__note">
          {{ section.settings.supporting_note | escape }}
        </p>
      {% endif %}
    </div>
  </div>
</section>


{% if has_video and section.settings.autoplay_video %}
  <script>
    (() => {
      const section = document.getElementById("HomeIntroduction-{{ section.id }}");
      const video = section?.querySelector("video");

      if (
        video &&
        window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        video.pause();
        video.removeAttribute("autoplay");
      }
    })();
  </script>
{% endif %}

{% schema %}
