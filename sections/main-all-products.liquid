{{ 'section-main-all-products.css' | asset_url | stylesheet_tag }}

{% liquid
  assign is_approved_customer = false
  assign selected_sort_by = collection.sort_by | default: collection.default_sort_by
  assign active_filter_count = 0
  assign clear_url = collection.url | append: '?view=all-products'

  if customer and settings.approved_customer_tag != blank
    if customer.tags contains settings.approved_customer_tag
      assign is_approved_customer = true
    endif
  endif

  unless is_approved_customer
    if selected_sort_by == 'price-ascending' or selected_sort_by == 'price-descending'
      assign selected_sort_by = 'manual'
    endif
  endunless

  for filter in collection.filters
    unless filter.type == 'price_range' and is_approved_customer == false
      assign active_filter_count = active_filter_count | plus: filter.active_values.size

      if filter.type == 'price_range'
        if filter.min_value.value != blank
          assign active_filter_count = active_filter_count | plus: 1
        endif

        if filter.max_value.value != blank
          assign active_filter_count = active_filter_count | plus: 1
        endif
      endif
    endunless
  endfor
%}

<section
  class="all-products"
  style="
    --all-products-background: {{ section.settings.background_color }};
    --all-products-text: {{ section.settings.text_color }};
    --all-products-muted: {{ section.settings.muted_text_color }};
    --all-products-border: {{ section.settings.border_color }};
    --all-products-card-background: {{ section.settings.card_background_color }};
    --all-products-accent: {{ section.settings.accent_color }};
    --all-products-accent-text: {{ section.settings.accent_text_color }};
    --all-products-columns-desktop: {{ section.settings.columns_desktop }};
    --all-products-columns-mobile: {{ section.settings.columns_mobile }};
    --all-products-gap: {{ section.settings.grid_gap }}px;
    --all-products-padding-top: {{ section.settings.padding_top }}px;
    --all-products-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <header class="all-products__header">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="all-products__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        <h1 class="all-products__heading">
          {% if section.settings.heading != blank %}
            {{ section.settings.heading | escape }}
          {% else %}
            {{ collection.title | escape }}
          {% endif %}
        </h1>

        {% if section.settings.description != blank %}
          <div class="all-products__description rte">{{ section.settings.description }}</div>
        {% elsif collection.description != blank %}
          <div class="all-products__description rte">{{ collection.description }}</div>
        {% endif %}
      </div>

      {% if section.settings.show_product_count %}
        <p class="all-products__count">
          <strong>{{ collection.products_count }}</strong>
          {% if collection.products_count == 1 %}product{% else %}products{% endif %}
        </p>
      {% endif %}
    </header>

    <div class="all-products__toolbar">
      <details class="all-products__filters">
        <summary class="all-products__filters-summary">
          <span>Filters</span>

          {% if active_filter_count > 0 %}
            <span class="all-products__filter-count">{{ active_filter_count }}</span>
          {% endif %}
        </summary>

        <div class="all-products__filters-panel">
          <form class="all-products__filter-form" action="{{ collection.url }}" method="get">
            <input type="hidden" name="view" value="all-products">

            <div class="all-products__filter-groups">
              {% for filter in collection.filters %}
                {% assign render_filter = true %}

                {% unless is_approved_customer %}
                  {% if filter.type == 'price_range' %}
                    {% assign render_filter = false %}
                  {% endif %}
                {% endunless %}

                {% if render_filter %}
                  <fieldset class="all-products__filter-group">
                    <legend class="all-products__filter-heading">{{ filter.label | escape }}</legend>

                    {% if filter.type == 'list' or filter.type == 'boolean' %}
                      <div class="all-products__filter-options">
                        {% for value in filter.values %}
                          {% assign filter_input_id = 'AllProductsFilter-' | append: section.id | append: '-' | append: forloop.parentloop.index | append: '-' | append: forloop.index %}

                          <label class="all-products__filter-option" for="{{ filter_input_id }}">
                            <input
                              id="{{ filter_input_id }}"
                              class="all-products__filter-checkbox"
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                              {% if value.count == 0 and value.active == false %}disabled{% endif %}
                            >

                            <span class="all-products__filter-box" aria-hidden="true"></span>
                            <span class="all-products__filter-label">{{ value.label | escape }}</span>
                            <span class="all-products__filter-value-count">{{ value.count }}</span>
                          </label>
                        {% endfor %}
                      </div>
                    {% elsif filter.type == 'price_range' and is_approved_customer %}
                      {% assign range_max = filter.range_max | money_without_currency | replace: ',', '' %}

                      <div class="all-products__price-fields">
                        <label class="all-products__price-field">
                          <span>Minimum</span>
                          <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            min="0"
                            max="{{ range_max }}"
                            step="0.01"
                            {% if filter.min_value.value != blank %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                          >
                        </label>

                        <label class="all-products__price-field">
                          <span>Maximum</span>
                          <input
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            min="0"
                            max="{{ range_max }}"
                            step="0.01"
                            {% if filter.max_value.value != blank %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                          >
                        </label>
                      </div>
                    {% endif %}
                  </fieldset>
                {% endif %}
              {% endfor %}
            </div>

            <div class="all-products__filter-actions">
              <button class="all-products__filter-apply" type="submit">Apply filters</button>
              <a class="all-products__filter-clear" href="{{ clear_url }}">Clear all</a>
            </div>
          </form>
        </div>
      </details>

      <form class="all-products__sort-form" action="{{ collection.url }}" method="get">
        <input type="hidden" name="view" value="all-products">

        {% for filter in collection.filters %}
          {% for value in filter.active_values %}
            <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
          {% endfor %}

          {% if filter.type == 'price_range' and is_approved_customer %}
            {% if filter.min_value.value != blank %}
              <input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}">
            {% endif %}

            {% if filter.max_value.value != blank %}
              <input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}">
            {% endif %}
          {% endif %}
        {% endfor %}

        <label class="all-products__sort-label" for="AllProductsSort-{{ section.id }}">Sort by</label>

        <select id="AllProductsSort-{{ section.id }}" class="all-products__sort-select" name="sort_by" onchange="this.form.submit()">
          {% for option in collection.sort_options %}
            {% assign show_sort_option = true %}

            {% unless is_approved_customer %}
              {% if option.value == 'price-ascending' or option.value == 'price-descending' %}
                {% assign show_sort_option = false %}
              {% endif %}
            {% endunless %}

            {% if show_sort_option %}
              <option value="{{ option.value }}" {% if option.value == selected_sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
            {% endif %}
          {% endfor %}
        </select>
      </form>
    </div>

    {% if active_filter_count > 0 %}
      <div class="all-products__active-filters" aria-label="Active filters">
        {% for filter in collection.filters %}
          {% unless filter.type == 'price_range' and is_approved_customer == false %}
            {% for value in filter.active_values %}
              <a class="all-products__active-filter" href="{{ value.url_to_remove }}">
                <span>{{ value.label | escape }}</span>
                <span aria-hidden="true">×</span>
              </a>
            {% endfor %}

            {% if filter.type == 'price_range' and is_approved_customer %}
              {% if filter.min_value.value != blank or filter.max_value.value != blank %}
                <a class="all-products__active-filter" href="{{ filter.url_to_remove }}">
                  <span>
                    {% if filter.min_value.value != blank %}From {{ filter.min_value.value | money }}{% endif %}
                    {% if filter.min_value.value != blank and filter.max_value.value != blank %}–{% endif %}
                    {% if filter.max_value.value != blank %}Up to {{ filter.max_value.value | money }}{% endif %}
                  </span>
                  <span aria-hidden="true">×</span>
                </a>
              {% endif %}
            {% endif %}
          {% endunless %}
        {% endfor %}

        <a class="all-products__active-filter all-products__active-filter--clear" href="{{ clear_url }}">Clear all</a>
      </div>
    {% endif %}

    {% paginate collection.products by section.settings.products_per_page %}
      {% if collection.products.size > 0 %}
        <div class="all-products__grid">
          {% for product in collection.products %}
            {% render 'all-products-card', product: product, is_approved_customer: is_approved_customer, show_vendor: section.settings.show_vendor, show_product_type: section.settings.show_product_type, show_compare_at_price: section.settings.show_compare_at_price, image_ratio: section.settings.image_ratio, image_fit: section.settings.image_fit %}
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
          <nav class="all-products__pagination" aria-label="Product pagination">
            {% if paginate.previous %}
              <a class="all-products__pagination-link" href="{{ paginate.previous.url }}">Previous</a>
            {% endif %}

            <span class="all-products__pagination-status">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>

            {% if paginate.next %}
              <a class="all-products__pagination-link" href="{{ paginate.next.url }}">Next</a>
            {% endif %}
          </nav>
        {% endif %}
      {% else %}
        <div class="all-products__empty">
          <h2>No products matched your filters.</h2>
          <a class="all-products__filter-clear" href="{{ clear_url }}">Clear all filters</a>
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Main all products",
  "tag": "section",
  "class": "section-main-all-products",
  "settings": [
    { "type": "header", "content": "Page heading" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop everything" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All products" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Browse the complete assortment and filter by availability, product type, vendor, or other configured Shopify filters.</p>" },
    { "type": "checkbox", "id": "show_product_count", "label": "Show product count", "default": true },
    { "type": "header", "content": "Product grid" },
    { "type": "range", "id": "products_per_page", "min": 12, "max": 48, "step": 4, "label": "Products per page", "default": 24 },
    { "type": "select", "id": "columns_desktop", "label": "Desktop columns", "options": [{ "value": "3", "label": "3 columns" }, { "value": "4", "label": "4 columns" }, { "value": "5", "label": "5 columns" }], "default": "4" },
    { "type": "select", "id": "columns_mobile", "label": "Mobile columns", "options": [{ "value": "1", "label": "1 column" }, { "value": "2", "label": "2 columns" }], "default": "2" },
    { "type": "range", "id": "grid_gap", "min": 8, "max": 40, "step": 4, "unit": "px", "label": "Grid spacing", "default": 24 },
    { "type": "select", "id": "image_ratio", "label": "Product image ratio", "options": [{ "value": "square", "label": "Square" }, { "value": "portrait", "label": "Portrait" }, { "value": "landscape", "label": "Landscape" }], "default": "portrait" },
    { "type": "select", "id": "image_fit", "label": "Product image fit", "options": [{ "value": "cover", "label": "Crop to fill" }, { "value": "contain", "label": "Fit entire image" }], "default": "cover" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_product_type", "label": "Show product type", "default": true },
    { "type": "checkbox", "id": "show_compare_at_price", "label": "Show compare-at price", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#241f1c" },
    { "type": "color", "id": "muted_text_color", "label": "Secondary text", "default": "#6e645d" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#d6cbc0" },
    { "type": "color", "id": "card_background_color", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#6b3f27" },
    { "type": "color", "id": "accent_text_color", "label": "Accent text", "default": "#ffffff" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 8, "unit": "px", "label": "Bottom padding", "default": 80 }
  ]
}
{% endschema %}
