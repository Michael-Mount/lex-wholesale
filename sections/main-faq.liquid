{{ 'section-main-faq.css' | asset_url | stylesheet_tag }}

{% liquid
  assign contact_url = '/pages/contact'
  assign faq_question_count = 0

  if section.settings.contact_page != blank
    assign contact_url = section.settings.contact_page.url
  endif

  for block in section.blocks
    if block.type == 'question'
      if block.settings.question != blank and block.settings.answer != blank
        assign faq_question_count = faq_question_count | plus: 1
      endif
    endif
  endfor
%}

<section
  class="faq-page"
  style="
    --faq-background: {{ section.settings.background_color }};
    --faq-text: {{ section.settings.text_color }};
    --faq-muted: {{ section.settings.muted_text_color }};
    --faq-border: {{ section.settings.border_color }};
    --faq-card-background: {{ section.settings.card_background_color }};
    --faq-accent: {{ section.settings.accent_color }};
    --faq-accent-text: {{ section.settings.accent_text_color }};
    --faq-padding-top: {{ section.settings.padding_top }}px;
    --faq-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <div class="faq-page__layout">
      <header class="faq-page__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="faq-page__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        <h1 class="faq-page__heading">
          {% if section.settings.heading != blank %}
            {{ section.settings.heading | escape }}
          {% else %}
            {{ page.title | escape }}
          {% endif %}
        </h1>

        {% if section.settings.introduction != blank %}
          <div class="faq-page__introduction rte">
            {{ section.settings.introduction }}
          </div>
        {% elsif page.content != blank %}
          <div class="faq-page__introduction rte">
            {{ page.content }}
          </div>
        {% endif %}

        {% if section.settings.show_contact_button and section.settings.contact_button_label != blank %}
          <a class="faq-page__contact-button" href="{{ contact_url }}">
            {{ section.settings.contact_button_label | escape }}
          </a>
        {% endif %}
      </header>

      <div class="faq-page__content">
        {% if section.blocks.size > 0 %}
          {% assign rendered_question_count = 0 %}

          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'category' %}
                {% if block.settings.heading != blank %}
                  <div class="faq-page__category" {{ block.shopify_attributes }}>
                    {% if block.settings.eyebrow != blank %}
                      <p class="faq-page__category-eyebrow">
                        {{ block.settings.eyebrow | escape }}
                      </p>
                    {% endif %}

                    <h2 class="faq-page__category-heading">
                      {{ block.settings.heading | escape }}
                    </h2>

                    {% if block.settings.text != blank %}
                      <div class="faq-page__category-text rte">
                        {{ block.settings.text }}
                      </div>
                    {% endif %}
                  </div>
                {% endif %}

              {% when 'question' %}
                {% if block.settings.question != blank and block.settings.answer != blank %}
                  {% assign rendered_question_count = rendered_question_count | plus: 1 %}
                  {% assign question_id = 'FaqQuestion-' | append: section.id | append: '-' | append: block.id %}

                  <details
                    class="faq-item"
                    {{ block.shopify_attributes }}
                    {% if section.settings.open_first_question and rendered_question_count == 1 %}open{% endif %}
                  >
                    <summary class="faq-item__summary">
                      <span id="{{ question_id }}" class="faq-item__question">
                        {{ block.settings.question | escape }}
                      </span>

                      <span class="faq-item__icon" aria-hidden="true"></span>
                    </summary>

                    <div class="faq-item__answer rte" aria-labelledby="{{ question_id }}">
                      {{ block.settings.answer }}

                      {% if block.settings.link_label != blank and block.settings.link_url != blank %}
                        <p class="faq-item__answer-link-wrapper">
                          <a class="faq-item__answer-link" href="{{ block.settings.link_url }}">
                            {{ block.settings.link_label | escape }}
                          </a>
                        </p>
                      {% endif %}
                    </div>
                  </details>
                {% endif %}
            {% endcase %}
          {% endfor %}
        {% elsif request.design_mode %}
          <div class="faq-page__empty">
            Add category and question blocks to build the FAQ page.
          </div>
        {% endif %}
      </div>
    </div>

    {% if section.settings.show_contact_panel %}
      <aside class="faq-contact-panel">
        <div>
          {% if section.settings.contact_panel_eyebrow != blank %}
            <p class="faq-contact-panel__eyebrow">
              {{ section.settings.contact_panel_eyebrow | escape }}
            </p>
          {% endif %}

          {% if section.settings.contact_panel_heading != blank %}
            <h2 class="faq-contact-panel__heading">
              {{ section.settings.contact_panel_heading | escape }}
            </h2>
          {% endif %}

          {% if section.settings.contact_panel_text != blank %}
            <div class="faq-contact-panel__text rte">
              {{ section.settings.contact_panel_text }}
            </div>
          {% endif %}
        </div>

        {% if section.settings.contact_panel_button_label != blank %}
          <a class="faq-contact-panel__button" href="{{ contact_url }}">
            {{ section.settings.contact_panel_button_label | escape }}
          </a>
        {% endif %}
      </aside>
    {% endif %}
  </div>
</section>

{% if section.settings.enable_faq_schema and faq_question_count > 0 %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {% assign schema_question_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'question' %}
            {% if block.settings.question != blank and block.settings.answer != blank %}
              {% assign schema_question_count = schema_question_count | plus: 1 %}
              {
                "@type": "Question",
                "name": {{ block.settings.question | json }},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{ block.settings.answer | strip_html | strip | json }}
                }
              }{% unless schema_question_count == faq_question_count %},{% endunless %}
            {% endif %}
          {% endif %}
        {% endfor %}
      ]
    }
  </script>
{% endif %}

{% schema %}
{
  "name": "Main FAQ",
  "tag": "section",
  "class": "section-main-faq",
  "max_blocks": 30,
  "settings": [
    {
      "type": "header",
      "content": "Page introduction"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Help center"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "<p>Find answers about wholesale access, ordering, complete collections, pricing, and product availability.</p>"
    },
    {
      "type": "checkbox",
      "id": "open_first_question",
      "label": "Open the first question by default",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_faq_schema",
      "label": "Enable FAQ structured data",
      "default": true,
      "info": "Only publish questions and answers that accurately reflect the store's policies."
    },
    {
      "type": "header",
      "content": "Contact link"
    },
    {
      "type": "page",
      "id": "contact_page",
      "label": "Contact page",
      "info": "Falls back to /pages/contact when no page is selected."
    },
    {
      "type": "checkbox",
      "id": "show_contact_button",
      "label": "Show contact button beside the introduction",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_button_label",
      "label": "Contact button label",
      "default": "Contact our team"
    },
    {
      "type": "checkbox",
      "id": "show_contact_panel",
      "label": "Show bottom contact panel",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_panel_eyebrow",
      "label": "Contact panel eyebrow",
      "default": "Still need help?"
    },
    {
      "type": "text",
      "id": "contact_panel_heading",
      "label": "Contact panel heading",
      "default": "Talk with our wholesale team"
    },
    {
      "type": "richtext",
      "id": "contact_panel_text",
      "label": "Contact panel text",
      "default": "<p>Reach out with questions about account approval, product options, collection ordering, or an existing order.</p>"
    },
    {
      "type": "text",
      "id": "contact_panel_button_label",
      "label": "Contact panel button label",
      "default": "Get in touch"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Page background",
      "default": "#f7f4ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#241f1c"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Secondary text",
      "default": "#6e645d"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#d6cbc0"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "Question background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#6b3f27"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Accent text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 32,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 32,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category heading",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Ordering"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Add a frequently asked question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Add the approved answer here.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Optional link label"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Optional link"
        }
      ]
    }
  ]
}
{% endschema %}
