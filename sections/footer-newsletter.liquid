{{ 'section-footer-newsletter.css' | asset_url | stylesheet_tag }}

{% assign form_id = 'FooterNewsletter-' | append: section.id %}
{% assign email_id = 'FooterNewsletterEmail-' | append: section.id %}
{% assign error_id = 'FooterNewsletterError-' | append: section.id %}
{% assign success_id = 'FooterNewsletterSuccess-' | append: section.id %}

<section
  class="footer-newsletter"
  style="
    --newsletter-background: {{ section.settings.background_color }};
    --newsletter-text: {{ section.settings.text_color }};
    --newsletter-muted: {{ section.settings.muted_text_color }};
    --newsletter-border: {{ section.settings.border_color }};
    --newsletter-button-background: {{ section.settings.button_background_color }};
    --newsletter-button-text: {{ section.settings.button_text_color }};
    --newsletter-padding-top: {{ section.settings.padding_top }}px;
    --newsletter-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <div class="footer-newsletter__inner">
      <div class="footer-newsletter__content">
        {% if section.settings.eyebrow != blank %}
          <p class="footer-newsletter__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="footer-newsletter__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="footer-newsletter__text rte">
            {{ section.settings.text }}
          </div>
        {% endif %}
      </div>

      <div class="footer-newsletter__form-wrapper">
        {% form 'customer', id: form_id, class: 'footer-newsletter__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          <div class="footer-newsletter__fields">
            <label class="visually-hidden" for="{{ email_id }}">
              Email address
            </label>

            <input
              id="{{ email_id }}"
              class="footer-newsletter__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.email_placeholder | escape }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              inputmode="email"
              aria-required="true"
              required
              {% if form.errors %}aria-invalid="true" aria-describedby="{{ error_id }}"{% endif %}
              {% if form.posted_successfully? %}aria-describedby="{{ success_id }}"{% endif %}
            >

            <button class="footer-newsletter__button" type="submit">
              {{ section.settings.button_label | escape }}
            </button>
          </div>

          {% if section.settings.privacy_note != blank %}
            <p class="footer-newsletter__privacy">
              {{ section.settings.privacy_note | escape }}

              {% if section.settings.privacy_page != blank %}
                <a href="{{ section.settings.privacy_page.url }}">
                  {{ section.settings.privacy_link_label | escape }}
                </a>
              {% endif %}
            </p>
          {% endif %}

          {% if form.errors %}
            <div id="{{ error_id }}" class="footer-newsletter__message footer-newsletter__message--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          {% if form.posted_successfully? %}
            <p id="{{ success_id }}" class="footer-newsletter__message" role="status">
              {{ section.settings.success_message | escape }}
            </p>
          {% endif %}
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Footer newsletter",
  "tag": "section",
  "class": "section-footer-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Retailer updates"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New collections, sent thoughtfully"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Receive collection launches, restock notices, and wholesale updates for independent retailers.</p>"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join the list"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you for joining our newsletter."
    },
    {
      "type": "text",
      "id": "privacy_note",
      "label": "Privacy note",
      "default": "By subscribing, you agree to receive marketing emails."
    },
    {
      "type": "page",
      "id": "privacy_page",
      "label": "Privacy policy page"
    },
    {
      "type": "text",
      "id": "privacy_link_label",
      "label": "Privacy link label",
      "default": "Privacy policy"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#eee7df"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#231f1c"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Secondary text",
      "default": "#6e645d"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#cfc4b9"
    },
    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background",
      "default": "#231f1c"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 32,
      "max": 96,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 32,
      "max": 96,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Footer newsletter"
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
