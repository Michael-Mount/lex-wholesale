{{ 'section-main-about-us.css' | asset_url | stylesheet_tag }}

{% liquid
  assign contact_url = '/pages/contact'

  if section.settings.contact_page != blank
    assign contact_url = section.settings.contact_page.url
  endif
%}

<section
  class="about-page about-page--image-{{ section.settings.image_position }}"
  style="
    --about-background: {{ section.settings.background_color }};
    --about-text: {{ section.settings.text_color }};
    --about-muted: {{ section.settings.muted_text_color }};
    --about-border: {{ section.settings.border_color }};
    --about-accent: {{ section.settings.accent_color }};
    --about-accent-text: {{ section.settings.accent_text_color }};
    --about-image-position: {{ section.settings.image_focal_position }};
    --about-image-height: {{ section.settings.image_height }}px;
    --about-content-width: {{ section.settings.content_width }}rem;
    --about-padding-top: {{ section.settings.padding_top }}px;
    --about-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width">
    <div class="about-page__layout{% if section.settings.image == blank %} about-page__layout--text-only{% endif %}">
      {% if section.settings.image != blank %}
        <div class="about-page__media">
          {% assign image_alt = section.settings.image.alt | default: section.settings.heading | default: page.title %}

          {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'about-page__image', widths: '480, 720, 960, 1200, 1500, 1800', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'eager', alt: image_alt }}

          {% if section.settings.image_caption != blank %}
            <p class="about-page__caption">
              {{ section.settings.image_caption | escape }}
            </p>
          {% endif %}
        </div>
      {% endif %}

      <div class="about-page__content">
        {% if section.settings.eyebrow != blank %}
          <p class="about-page__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        <h1 class="about-page__heading">
          {% if section.settings.heading != blank %}
            {{ section.settings.heading | escape }}
          {% else %}
            {{ page.title | escape }}
          {% endif %}
        </h1>

        {% if section.settings.introduction != blank %}
          <div class="about-page__introduction rte">
            {{ section.settings.introduction }}
          </div>
        {% endif %}

        {% if section.settings.body != blank %}
          <div class="about-page__body rte">
            {{ section.settings.body }}
          </div>
        {% elsif page.content != blank %}
          <div class="about-page__body rte">
            {{ page.content }}
          </div>
        {% endif %}

        {% if section.settings.contact_button_label != blank %}
          <div class="about-page__actions">
            <a class="about-page__button" href="{{ contact_url }}">
              {{ section.settings.contact_button_label | escape }}
            </a>
          </div>
        {% endif %}
      </div>
    </div>

    {% if section.settings.show_contact_panel %}
      <aside class="about-contact-panel">
        <div>
          {% if section.settings.contact_eyebrow != blank %}
            <p class="about-contact-panel__eyebrow">
              {{ section.settings.contact_eyebrow | escape }}
            </p>
          {% endif %}

          {% if section.settings.contact_heading != blank %}
            <h2 class="about-contact-panel__heading">
              {{ section.settings.contact_heading | escape }}
            </h2>
          {% endif %}

          {% if section.settings.contact_text != blank %}
            <div class="about-contact-panel__text rte">
              {{ section.settings.contact_text }}
            </div>
          {% endif %}
        </div>

        {% if section.settings.contact_panel_button_label != blank %}
          <a class="about-contact-panel__button" href="{{ contact_url }}">
            {{ section.settings.contact_panel_button_label | escape }}
          </a>
        {% endif %}
      </aside>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main about us",
  "tag": "section",
  "class": "section-main-about-us",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "About image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Image left"
        },
        {
          "value": "right",
          "label": "Image right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_focal_position",
      "label": "Image focal position",
      "options": [
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 420,
      "max": 760,
      "step": 20,
      "unit": "px",
      "label": "Desktop image height",
      "default": 620
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Image caption"
    },
    {
      "type": "header",
      "content": "About content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wholesale collections built with intention"
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "<p>We help retailers discover coordinated assortments that feel considered, cohesive, and ready for the sales floor.</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Our approach is centered on thoughtful curation and a simpler buying experience. Each collection is designed to tell a clear story while still giving retailers the flexibility to choose the right sizes, colors, and quantities for their customers.</p><p>From seasonal edits to complete collection ordering, our goal is to make wholesale purchasing feel more visual, more efficient, and easier to navigate.</p>"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 26,
      "max": 50,
      "step": 2,
      "unit": "rem",
      "label": "Text width",
      "default": 38
    },
    {
      "type": "header",
      "content": "Contact link"
    },
    {
      "type": "page",
      "id": "contact_page",
      "label": "Contact page",
      "info": "Falls back to /pages/contact when no page is selected."
    },
    {
      "type": "text",
      "id": "contact_button_label",
      "label": "Main contact button label",
      "default": "Contact us"
    },
    {
      "type": "checkbox",
      "id": "show_contact_panel",
      "label": "Show contact panel",
      "default": true
    },
    {
      "type": "text",
      "id": "contact_eyebrow",
      "label": "Contact panel eyebrow",
      "default": "Start a conversation"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact panel heading",
      "default": "Interested in working with us?"
    },
    {
      "type": "richtext",
      "id": "contact_text",
      "label": "Contact panel text",
      "default": "<p>Reach out with questions about wholesale access, collections, ordering, or becoming a retail partner.</p>"
    },
    {
      "type": "text",
      "id": "contact_panel_button_label",
      "label": "Contact panel button label",
      "default": "Get in touch"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Page background",
      "default": "#f7f4ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#241f1c"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Secondary text",
      "default": "#6e645d"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Borders",
      "default": "#d6cbc0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Buttons and accents",
      "default": "#6b3f27"
    },
    {
      "type": "color",
      "id": "accent_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Main about us"
    }
  ]
}
{% endschema %}
